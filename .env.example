# Whoop API — create an app at https://developer-dashboard.whoop.com
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=

# Oura API — create an app at https://cloud.ouraring.com/oauth/applications
OURA_CLIENT_ID=
OURA_CLIENT_SECRET=

# OAuth callback. Must match the redirect URI registered with the provider
# EXACTLY, or the token exchange fails with redirect_uri_mismatch.
# Default is http://localhost:8080/callback.
OAUTH_REDIRECT_PORT=8080
# OAUTH_REDIRECT_URI=http://localhost:8080/callback

# Per-provider overrides, if the two apps are registered with different URIs.
# WHOOP_REDIRECT_URI=
# OURA_REDIRECT_URI=
